[Unit]
Description=Run RAQIB Threat Intelligence periodic updates (Feodo & ATT&CK)
Documentation=https://github.com/Ali5667/RAQIB-Defensive-Security-Toolkit

[Timer]
# Run 10 minutes after boot, then check every 12 hours
OnBootSec=10min
OnUnitActiveSec=12h
Persistent=true

[Install]
WantedBy=timers.target
